{
  "name": "petcare-netlify-functions",
  "version": "1.3.1",
  "description": "Serverless functions for PetCare Application",
  "type": "module",
  "scripts": {
"build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint --quiet .",
        "test": "vitest --config ../vitest.config.ts",
        "test:run": "vitest run --config ../vitest.config.ts",
        "test:coverage": "vitest run --config ../vitest.config.ts --coverage"
  },
  "dependencies": {
    "@netlify/functions": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pusher": "^5.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.2.4"
  }
}
